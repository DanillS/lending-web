# PostgreSQL
POSTGRES_USER=doors
POSTGRES_PASSWORD=doors
POSTGRES_DB=doors
DATABASE_URL=postgresql+asyncpg://doors:doors@postgres:5432/doors

# Redis
REDIS_URL=redis://redis:6379/0

# development | production (production rejects default secrets and requires https SITE_URL)
APP_ENV=development

# API — на сервере: ./infra/gen-secrets.sh и вставьте значения
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1

# Admin seed (пароль читается только если пользователя ещё нет)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# Public site — на проде https://ваш-домен без слеша в конце
SITE_URL=http://localhost
SITE_NAME=Качественные двери

# Notifications — без токенов заявка только в админке
# Бот: @BotFather → TELEGRAM_BOT_TOKEN, чат: напишите боту и узнайте id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web Push (PWA админки). Пустые — ключи создадутся в БД при первом «Включить уведомления».
# На проде можно зафиксировать: docker compose run --rm api python -c "from app.services.push import generate_vapid_keys; print(generate_vapid_keys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_USER=
EMAIL_PASS=
ADMIN_PHONE=79503101560
SENTRY_DSN=

# Next.js

# Next.js
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=http://localhost
